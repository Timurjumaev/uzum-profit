# Uzum seller kabinetidagi API kalit. Hech kimga bermang va bu faylni git'ga qo'shmang.
# Bu faylni ".env" nomi bilan nusxalang va kalitni yozing.
UZUM_API_KEY=

# Uzum logistika va saqlashni bepul qilgan davr. Undan keyin standart tarif qaytadi.
FREE_LOGISTICS_FROM=2026-10-10
FREE_LOGISTICS_TO=2026-10-31

# Standart logistika (1 dona, so'm). Faqat SKU bo'yicha tarix bo'lmasa ishlatiladi.
STD_LOGISTICS=5250

# "Qayta ishlanmoqda" buyurtmalarning qancha qismi yakunlanadi (tarixda ~0.72-0.75).
PENDING_REALIZATION=0.75

# Har bir do'kon uchun BIRINCHI yangilashda butun tarix (eng birinchi sotuvdan boshlab) o'zi olinadi.
# Keyingi yangilashlarda statuslar o'zgargani uchun oxirgi SYNC_DAYS kun qayta olinadi.
SYNC_DAYS=30

# Ombor sahifasi: buyurtma berilgandan tovar Uzum omborida sotuvga chiqquncha o'tadigan kunlar
# (Xitoydan kelish 20-25 kun + shtrix kod yopishtirish va Uzumga topshirish). O'zingizga moslang.
LEAD_DAYS=30
